{
  "name": "inmert.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc -b && bun --bun vite build",
    "lint": "bun --bun eslint .",
    "preview": "bun --bun vite preview",
    "deploy": "bun run build && bun --bun gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "devicons-react": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
